# Local development settings. Copy to .env and adjust.
# Every variable is documented in docs/setup.md. Never commit .env.

RAG_ENVIRONMENT=local
RAG_AUTH_MODE=local
# Any long random string. Signs local development tokens only.
RAG_LOCAL_AUTH_SECRET=change-me-to-a-long-random-string-for-local-tokens

RAG_DB_BACKEND=psycopg
RAG_ADMIN_DATABASE_URL=postgresql://rag_owner:rag_owner_local@localhost:55432/ragplatform
RAG_DATABASE_URL=postgresql://rag_app:6c6f63616c2d6465762d6f6e6c792d70617373776f7264@localhost:55432/ragplatform
# Must match the password in RAG_DATABASE_URL. Hex only (the migrator rejects anything else).
RAG_LOCAL_APP_DB_PASSWORD=6c6f63616c2d6465762d6f6e6c792d70617373776f7264

RAG_BLOB_BACKEND=local
RAG_LOCAL_BLOB_DIR=.data/blobs
RAG_INGEST_MODE=inline

# fake: offline and deterministic. gemini: real models on the free tier.
RAG_PROVIDER=fake
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
RAG_CHAT_MODEL_ID=us.amazon.nova-2-lite-v1:0

# To use Gemini instead (https://aistudio.google.com/apikey):
# RAG_PROVIDER=gemini
# RAG_GEMINI_API_KEY=...
# RAG_EMBEDDING_MODEL_ID=gemini-embedding-001
# RAG_CHAT_MODEL_ID=gemini-flash-latest
# Changing provider or embedding model on an existing database needs
# `ragplatform reembed` or a fresh database (`docker compose down -v`).
